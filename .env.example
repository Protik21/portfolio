# Both values are set automatically by the GitHub Pages workflow (.github/workflows/deploy.yml).
# Only set them locally to test a production-like build.

# Sub-path the site is served from, e.g. /portfolio. Leave empty to serve from the root.
NEXT_PUBLIC_BASE_PATH=

# Full public URL including the base path, no trailing slash, e.g. https://protik21.github.io/portfolio.
# Enables the canonical URL, og:url and og:image tags.
NEXT_PUBLIC_SITE_URL=
